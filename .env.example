# ============================================================
# LocalShop — Ortam Değişkenleri Örneği
# ============================================================
# Bu dosyayı .env olarak kopyalayıp değerleri doldurun:
#   cp .env.example .env
# ============================================================

# === VERİTABANI ===
# Docker Compose kullanıyorsanız bu değerleri değiştirmenize gerek yok.
POSTGRES_USER=localshop_user
POSTGRES_PASSWORD=localshop123
POSTGRES_DB=localshop
DATABASE_URL=postgresql://localshop_user:localshop123@db:5432/localshop

# === REDIS ===
REDIS_PASSWORD=localshop_redis_123
REDIS_URL=redis://:localshop_redis_123@redis:6379/0

# === AUTH (JWT) ===
SECRET_KEY=buraya-guclu-bir-secret-key-girin-en-az-32-karakter
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# === AI (OpenAI) ===
# gpt-4o-mini modeli ile çalışır. API anahtarını https://platform.openai.com adresinden alabilirsiniz.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=10
OPENAI_MAX_RETRIES=3

# === KARGO ===
YURTICI_API_KEY=
YURTICI_API_URL=https://api.yurticikargo.com
PTT_API_KEY=
CARGO_CHECK_INTERVAL_HOURS=2

# === BİLDİRİM (E-posta) ===
SENDGRID_API_KEY=
FROM_EMAIL=noreply@localshop.com
ADMIN_EMAIL=admin@localshop.com

# === WHATSAPP ===
WHATSAPP_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_ID=

# === UYGULAMA ===
APP_ENV=development
RATE_LIMIT_ENABLED=true
SWAGGER_ENABLED=true
LOG_LEVEL=INFO
BRIEFING_CRON_HOUR=8
BRIEFING_CRON_MINUTE=0

# === CORS ===
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
