# LocalShop — Ortam Değişkenleri Örneği
# Bu dosyayı .env olarak kopyalayıp değerleri doldurun:
#   cp .env.example .env

# === VERİTABANI ===
DATABASE_URL=postgresql://kullanici:sifre@localhost:5432/localshop
REDIS_URL=redis://:sifre@localhost:6379/0

# === AUTH ===
SECRET_KEY=buraya-guclu-bir-secret-key-girin-en-az-32-karakter
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# === AI ===
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT_SECONDS=10
GEMINI_MAX_RETRIES=3

# === KARGO ===
YURTICI_API_KEY=
YURTICI_API_URL=https://api.yurticikargo.com
PTT_API_KEY=
CARGO_CHECK_INTERVAL_HOURS=2

# === BİLDİRİM ===
SENDGRID_API_KEY=
FROM_EMAIL=noreply@localshop.com
ADMIN_EMAIL=admin@localshop.com

# === WHATSAPP ===
WHATSAPP_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_ID=

# === UYGULAMA ===
APP_ENV=development
RATE_LIMIT_ENABLED=true
SWAGGER_ENABLED=true
LOG_LEVEL=INFO
BRIEFING_CRON_HOUR=8
BRIEFING_CRON_MINUTE=0

# === CORS ===
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]
