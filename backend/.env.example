# LocalShop — Ortam Değişkenleri Örneği
# Bu dosyayı .env olarak kopyalayıp değerleri doldurun:
#   cp .env.example .env

# Veritabanı bağlantısı
DATABASE_URL=postgresql://kullanici:sifre@localhost:5432/localshop

# JWT ayarları (SECRET_KEY en az 32 karakter olmalı)
SECRET_KEY=buraya-guclu-bir-secret-key-girin-en-az-32-karakter
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Google Gemini AI
GEMINI_API_KEY=buraya-gemini-api-anahtarinizi-girin

# CORS — izin verilen frontend adresleri (JSON array formatında)
CORS_ORIGINS=["http://localhost:5173","https://yourdomain.com"]
